# ─── Medusa (Commerce Backend) ────────────────────────────────────────────────
# Your hosted Medusa server URL (Railway, Render, etc.)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-medusa-instance.up.railway.app

# Publishable key — safe to expose in browser. Create in Medusa Admin → Settings → API Keys → Publishable Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# NGN region ID — find in Medusa Admin → Settings → Regions
NEXT_PUBLIC_MEDUSA_REGION_ID=reg_...

# Per-market inventory (optional): make Canada read + decrement its own stock
# location instead of the shared pool. Provisioned by scripts/setup-markets.ts.
# Set BOTH together, and only after the Canada location has been stocked —
# otherwise the CA storefront correctly shows everything out of stock. Leave
# unset to keep a single shared pool.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY_CA=pk_...
NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID_CA=sc_...

# Admin credentials — server-side only, used by the payment verification API route
MEDUSA_ADMIN_EMAIL=admin@yourdomain.com
MEDUSA_ADMIN_PASSWORD=your-admin-password

# ─── Paystack (Payments) ──────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Sanity (CMS — used for B2B enquiry form) ─────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=sk...

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://impactperfumes.com

# ─── Scripts only (never add to Vercel) ───────────────────────────────────────
# Admin API key — only needed to run local seed scripts (seed-products, migrate-notes, etc.)
# MEDUSA_ADMIN_API_KEY=your-admin-api-key
